{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {"matchUpdateTypes": ["major"], "enabled": false},
    {"matchPackageNames": ["registry.fedoraproject.org/fedora"], "allowedVersions": "44"},
    {"matchDatasources": ["docker", "github-release-attachments"], "pinDigests": true},
    {"matchPackageNames": ["oven-sh/bun"], "versioning": "regex:^bun-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"}
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^config/tools\\.env$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z0-9_]+=(?<currentValue>\\S+)(?: [A-Z0-9_]+=(?<currentDigest>[a-f0-9]{64}))?"],
      "versioningTemplate": "semver"
    }
  ]
}
