# Copy to .env beside the build files. Shell variables override these settings.
CLAWK_ENGINE=podman
CLAWK_IMAGE_TAG=localhost/clawk-fedora:44

# Default: $XDG_DATA_HOME/clawk/images or ~/.local/share/clawk/images.
# Use literal paths in .env; expand "$HOME/..." in shell overrides.
# CLAWK_IMAGE_DIR="/absolute/path/to/clawk/images"

# Optional full filename, overriding CLAWK_IMAGE_DIR.
# CLAWK_IMAGE_ARCHIVE="/absolute/path/to/clawk/images/clawk-fedora-44.tar"
